# --- Global Default ---
# Treat everything as text and convert to native OS line endings by default
* text=auto

# --- Binary Files ---
# Tell Git to treat these as binary (no line ending conversion, no text diffs)
*.jar binary
*.p12 binary
*.pem binary
*.key binary

# --- Linux/Unix Scripts (Force LF) ---
# Critical for shell scripts to work on Linux/Docker/WSL
*.sh text eol=lf
mvnw text eol=lf
gradlew text eol=lf

# --- Windows Scripts (Force CRLF) ---
# Critical for batch files to work on Windows cmd
*.cmd text eol=crlf
*.bat text eol=crlf
mvnw.cmd text eol=crlf
gradlew.bat text eol=crlf